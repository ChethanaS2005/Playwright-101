{
  "name": "playwright-101-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "TestMu AI Playwright 101 certification assignment",
  "scripts": {
    "test": "playwright test",
    "test:cloud": "playwright test --config=playwright.cloud.config.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report playwright-report/local",
    "report:cloud": "playwright show-report playwright-report/cloud",
    "sessions": "node scripts/session-summary.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "typescript": "7.0.2"
  }
}
